# ==========================================
# PERFAI × SENATRIA — Production Environment
# ==========================================

# 1. Core Site Configuration
NEXT_PUBLIC_SITE_URL=https://perfai.in

# 2. Database (PostgreSQL / Supabase / Neon - Mumbai Region)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres?schema=public"

# 3. Authentication (Auth.js session secret)
AUTH_SECRET="perfai-super-secret-key-32-chars-long"

# 4. Admin Seeding Credentials
ADMIN_SEED_EMAIL="admin@perfai.in"
ADMIN_SEED_PASSWORD="ChangeMeInProduction2026!"

# 5. Email Infrastructure (Resend API)
RESEND_API_KEY="re_placeholder_token"
MAIL_FROM="no-reply@perfai.in"
SALES_NOTIFY_EMAIL="leads@perfai.in"

# 6. Anti-Spam Security (Cloudflare Turnstile)
TURNSTILE_SITE_KEY="0x4AAAAAA..."
TURNSTILE_SECRET="0x4AAAAAA..."

# 7. Rate Limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL="https://[YOUR-ID].upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# 8. Analytics & Telemetry (Opt-in only)
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_CLARITY_ID="your-clarity-id"

# 9. Monitoring & Sentry
SENTRY_DSN="https://key@sentry.io/project"

# 10. Privacy & Compliance (DPDP Act 2023)
IP_HASH_SALT="perfai-salt-secret-for-hashing-ips"

# 11. External Integrations (Optional)
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."
