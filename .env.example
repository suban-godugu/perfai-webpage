# System & Environment Variables for PERFAI Website

# Public URL
NEXT_PUBLIC_SITE_URL=https://perfai.in

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database Connection (Supabase PostgreSQL / Prisma)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?schema=public&pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?schema=public"

# Admin Authentication Secret (For JWT/Session cookies)
AUTH_SECRET=perfai-super-secret-enterprise-key-change-in-production

# Email Service (Resend or SMTP)
RESEND_API_KEY=re_placeholder_key
NOTIFICATION_EMAIL=leads@perfai.in
FROM_EMAIL=no-reply@perfai.in

# Analytics & Verification
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
GOOGLE_SITE_VERIFICATION=your-site-verification-token
