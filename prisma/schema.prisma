generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  SALES
  EDITOR
  VIEWER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  ASSESSMENT_SCHEDULED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
  NURTURE
}

enum LeadPriority {
  HOT
  WARM
  COLD
}

enum LeadSource {
  ASSESSMENT_FORM
  CONTACT_FORM
  CALCULATOR
  RESOURCE_DOWNLOAD
  NEWSLETTER
  COMPUTESHIELD_WAITLIST
  PARTNER_FORM
  MANUAL
  IMPORT
}

enum Region {
  INDIA
  INTERNATIONAL
}

enum RoleType {
  OWNER
  ASSET_MANAGER
  FACILITIES
  ESG_SUSTAINABILITY
  ENERGY
  DEVELOPER
  CONSULTANT
  OTHER
}

enum AssetType {
  OFFICE
  HOSPITALITY
  HEALTHCARE
  RETAIL_MALL
  DATA_CENTRE
  EDUCATION_CAMPUS
  INDUSTRIAL
  MIXED_USE
  RESIDENTIAL_PORTFOLIO
  OTHER
}

enum Challenge {
  ENERGY_COST
  DEMAND_CHARGES
  GREEN_RATING
  MAINTENANCE
  GRID_FLEXIBILITY
  COMPUTE_CAPACITY
  RELIABILITY
  OTHER
}

enum Solution {
  ATRIA
  BUILDINGSHIELD
  GRIDSHIELD
  COMPUTESHIELD
}

enum ActivityType {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  NOTE_ADDED
  EMAIL_SENT
  EMAIL_RECEIVED
  CALL_LOGGED
  MEETING_LOGGED
  TASK_CREATED
  TASK_COMPLETED
  SCORE_CHANGED
  EDITED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EvidenceLevel {
  MEASURED
  MODELLED
  PROJECTED
  INDICATIVE
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  passwordHash String
  role         Role           @default(SALES)
  isActive     Boolean        @default(true)
  regions      Region[]
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  leads        Lead[]         @relation("LeadAssignee")
  activities   LeadActivity[]
  notes        LeadNote[]
  tasks        Task[]         @relation("TaskAssignee")
  auditLogs    AuditLog[]
}

model Lead {
  id               String           @id @default(cuid())
  fullName         String
  email            String
  phone            String?
  roleType         RoleType?
  jobTitle         String?
  organisation     String?
  assetType        AssetType?
  scaleDescription String?
  buildingCount    Int?
  floorAreaSqm     Int?
  challenge        Challenge?
  solutions        Solution[]
  region           Region           @default(INDIA)
  country          String?
  city             String?
  message          String?
  status           LeadStatus       @default(NEW)
  priority         LeadPriority     @default(COLD)
  score            Int              @default(0)
  source           LeadSource
  estimatedValue   Decimal?         @db.Decimal(14, 2)
  currency         String           @default("INR")
  lostReason       String?
  wonAt            DateTime?
  closedAt         DateTime?
  firstContactedAt DateTime?
  // attribution
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmTerm          String?
  utmContent       String?
  referrer         String?
  landingPage      String?
  // compliance
  consentAt        DateTime
  consentVersion   String
  ipHash           String?
  userAgent        String?
  // relations
  assigneeId       String?
  assignee         User?            @relation("LeadAssignee", fields: [assigneeId], references: [id])
  activities       LeadActivity[]
  notes            LeadNote[]
  tasks            Task[]
  tags             LeadTag[]
  submissions      FormSubmission[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  @@index([email])
  @@index([status, priority])
  @@index([assigneeId, status])
  @@index([region, createdAt])
  @@index([source, createdAt])
}

model FormSubmission {
  id        String     @id @default(cuid())
  leadId    String?
  lead      Lead?      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  formType  LeadSource
  payload   Json
  createdAt DateTime   @default(now())

  @@index([formType, createdAt])
}

model LeadActivity {
  id        String       @id @default(cuid())
  leadId    String
  lead      Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      ActivityType
  actorId   String?
  actor     User?        @relation(fields: [actorId], references: [id])
  data      Json?
  createdAt DateTime     @default(now())

  @@index([leadId, createdAt])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

model Task {
  id          String    @id @default(cuid())
  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assigneeId  String
  assignee    User      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  title       String
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([assigneeId, completedAt, dueAt])
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  color String    @default("#64748B")
  leads LeadTag[]
}

model LeadTag {
  leadId String
  tagId  String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  region         Region?
  consentAt      DateTime
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
}

model CaseStudy {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  summary       String
  body          String
  assetType     AssetType?
  country       String
  scope         String
  period        String?
  baseline      String?
  evidence      EvidenceLevel
  metrics       Json
  isSenatriaRef Boolean       @default(true)
  sourceUrl     String?
  heroImage     String?
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Resource {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  excerpt     String
  body        String
  type        String
  fileUrl     String?
  isGated     Boolean       @default(false)
  seoTitle    String?
  seoDesc     String?
  ogImage     String?
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Faq {
  id       String        @id @default(cuid())
  question String
  answer   String
  page     String        @default("home")
  position Int           @default(0)
  status   ContentStatus @default(PUBLISHED)
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Webhook {
  id        String   @id @default(cuid())
  url       String
  secret    String
  events    String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  template  String
  leadId    String?
  status    String
  error     String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
